-- ========== HOOK InvokeServer ==========
-- نعترض Throw_Complete ونحقن قيمة 20 للـ luck
local old_nc
old_nc = hookmetamethod(game,"__namecall",newcclosure(function(self,...)
    local method = getnamecallmethod()
    if method == "InvokeServer" then
        local name = tostring(self.Name)
        -- عند Throw_Complete نحقن luck = 20
        if name == "Throw_Complete" then
            local args = {...}
            -- نطبع args لنرى ما يُرسل
            for i,v in ipairs(args) do
                if type(v) == "number" then
                    -- نرفع أي قيمة بين 0-20 لـ 20
                    if v >= 0 and v <= 20 then
                        args[i] = 20
                    end
                end
            end
            return old_nc(self, table.unpack(args))
        end
        -- Throw_Resolve أيضاً
        if name == "Throw_Resolve" then
            local args = {...}
            for i,v in ipairs(args) do
                if type(v)=="number" and v>=0 and v<=20 then
                    args[i] = 20
                end
            end
            return old_nc(self, table.unpack(args))
        end
    end
    return old_nc(self,...)
end))

-- ========== SET THROW POWER ==========
local function setThrowPower(val)
    pcall(function()
        SetThrowPower:InvokeServer(val)
    end)
    -- تعديل مباشر
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            local tp = ls:FindFirstChild("Throw Power")
            if tp then tp.Value = val end
        end
    end)
end

-- ========== AUTO TRAINING ==========
local function doTraining()
    task.spawn(function()
        pcall(function()
            Training_Start:InvokeServer()
            task.wait(0.3)
            -- اضغط بسرعة 10 مرات
            for i=1,10 do
                pcall(function() Training_Bonus:InvokeServer() end)
                task.wait(0.05)
            end
            task.wait(0.2)
            Training_Stop:InvokeServer()
        end)
    end)
end

-- ========== AUTO THROW ==========
local function doThrow()
    pcall(function()
        -- بدء الرمية
        Throw_Start:InvokeServer()
        task.wait(0.1)
        -- إرسال النتيجة مع luck = 20
        Throw_Complete:InvokeServer(20)
    end)
end


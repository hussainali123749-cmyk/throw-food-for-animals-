-- ========== STRENGTH LOGIC ==========
local strVal = 10000
local function updateDisplay()
    ValDisplay.Text = "Value: " .. tostring(strVal)
end

BtnPlus.MouseButton1Click:Connect(function()
    strVal = strVal + 1000
    updateDisplay()
end)
BtnMinus.MouseButton1Click:Connect(function()
    strVal = math.max(100, strVal - 1000)
    updateDisplay()
end)
BtnReset.MouseButton1Click:Connect(function()
    strVal = 7303
    updateDisplay()
end)

ApplyBtn.MouseButton1Click:Connect(function()
    StatusTxt.Text = "● Applying..."
    StatusTxt.TextColor3 = Color3.fromRGB(255, 200, 50)

    -- طريقة 1: تعديل مباشر في leaderstats
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            for _, v in pairs(ls:GetChildren()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    if math.abs(v.Value - 7303) < 500 
                    or v.Name:lower():find("str") 
                    or v.Name:lower():find("power")
                    or v.Name:lower():find("muscle") then
                        v.Value = strVal
                    end
                end
            end
        end
    end)

    -- طريقة 2: RemoteEvent
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        for _, v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                if n:find("strength") or n:find("upgrade")
                or n:find("train") or n:find("stat") then
                    v:FireServer(strVal)
                end
            end
        end
    end)

    -- طريقة 3: بحث بالقيمة الحالية
    pcall(function()
        strengthValue = strVal
        for _, v in pairs(lp:GetDescendants()) do
            if (v:IsA("NumberValue") or v:IsA("IntValue")) then
                if v.Value == 7303 or v.Name:lower():find("str") then
                    v.Value = strVal
                end
            end
        end
    end)

    task.wait(0.4)
    StatusTxt.Text = "● Done — " .. strVal
    StatusTxt.TextColor3 = Color3.fromRGB(80, 255, 80)
end)


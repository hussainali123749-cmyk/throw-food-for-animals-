-- ========== HOOK THROW ==========
local mt = getrawmetatable(game)
local old_namecall
old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        local name = tostring(self.Name):lower()
        -- Luck Hack: نعترض Throw_Start ونحقن قيمة 20
        if luckHackOn and (name:find("throw") or name:find("luck")) then
            local args = {...}
            for i, v in ipairs(args) do
                if type(v) == "number" and v >= 0 and v <= 25 then
                    args[i] = 20
                end
            end
            return old_namecall(self, table.unpack(args))
        end
    end
    return old_namecall(self, ...)
end))

-- ========== STRENGTH LOCK ==========
local strengthConnection = nil

local function startStrengthLock()
    if StrengthValue then
        strengthConnection = StrengthValue:GetPropertyChangedSignal("Value"):Connect(function()
            if strengthLockOn and StrengthValue.Value ~= customStrength then
                StrengthValue.Value = customStrength
            end
        end)
    end
end

local function setStrengthNow(val)
    -- طريقة 1: مباشر
    pcall(function()
        if StrengthValue then
            StrengthValue.Value = val
        end
    end)
    -- طريقة 2: RemoteEvent
    pcall(function()
        for _, v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                if n:find("strength") or n:find("upgrade") 
                or n:find("stat") or n:find("set") then
                    v:FireServer(val)
                end
            end
        end
    end)
    -- طريقة 3: Throw_Complete مع قيمة عالية
    pcall(function()
        local throwComplete = RS.Remotes:FindFirstChild("Throw_Complete")
        if throwComplete then
            throwComplete:FireServer(val)
        end
    end)
end

startStrengthLock()


-- ========== FIND LUCK BAR ==========
local function findLuckBar()
    -- نبحث عن Frame عمودي يتغير حجمه
    for _, v in pairs(lp.PlayerGui:GetDescendants()) do
        if v:IsA("Frame") then
            local sz = v.AbsoluteSize
            -- البار العمودي: طوله أكبر من عرضه
            if sz.Y > sz.X * 2 and sz.Y > 50 then
                return v
            end
        end
    end
    return nil
end

-- ========== FIND STRENGTH ==========
local StrengthValue = nil
local function findStrength()
    -- بحث بالقيمة 7303
    for _, v in pairs(lp:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            if math.abs(v.Value - 7303) < 200 then
                return v
            end
        end
    end
    -- بحث بالاسم
    for _, v in pairs(lp:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            local n = v.Name:lower()
            if n:find("strength") or n:find("str") or n:find("power") then
                return v
            end
        end
    end
    return nil
end
StrengthValue = findStrength()

-- ========== HOOK NAMECALL ==========
local luckHackOn = false
local autoThrowOn = false
local customStrength = 9999

local old_namecall
old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" then
        local name = tostring(self.Name):lower()
        if luckHackOn and (name:find("throw") or name == "throw_start") then
            local args = {...}
            for i, v in ipairs(args) do
                if type(v) == "number" and v >= 0 and v <= 25 then
                    args[i] = 20
                end
            end
            return old_namecall(self, table.unpack(args))
        end
    end
    return old_namecall(self, ...)
end))

-- ========== AUTO THROW SYSTEM ==========
-- يراقب البار ويرمي تلقائياً عند 20
local autoThrowConnection = nil

local function startAutoThrow()
    if autoThrowConnection then
        autoThrowConnection:Disconnect()
    end

    autoThrowConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not autoThrowOn then return end
        if not ThrowStart then return end

        pcall(function()
            -- طريقة 1: نضغط على الشاشة تلقائياً
            -- نحاكي الضغط على الشاشة
            local vs = game:GetService("VirtualInputManager")
            if vs then
                -- ضغط في وسط الشاشة
                local cam = workspace.CurrentCamera
                local center = cam.ViewportSize / 2
                vs:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
                task.wait(0.05)
                vs:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
            end
        end)

        -- طريقة 2: FireServer مباشرة بقيمة 20
        pcall(function()
            if luckHackOn then
                ThrowStart:FireServer(20)
            else
                ThrowStart:FireServer(math.random(15, 20))
            end
        end)

        -- انتظر قبل الرمية التالية
        task.wait(2 + math.random())
    end)
end

-- ========== SET STRENGTH ==========
local function setStrengthNow(val)
    pcall(function()
        if StrengthValue then
            StrengthValue.Value = val
        end
    end)
    pcall(function()
        for _, v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                if n:find("strength") or n:find("upgrade")
                or n:find("stat") or n:find("set") then
                    v:FireServer(val)
                end
            end
        end
    end)
    pcall(function()
        if ThrowComplete then
            ThrowComplete:FireServer(val)
        end
    end)
end


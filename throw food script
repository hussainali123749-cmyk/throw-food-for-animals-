-- ========== AI SCAN FUNCTION ==========
local function runAIScan()
    aiDone = false
    AIStatusTxt.Text = "🧠 جاري مسح الماب..."
    AIStatusTxt.TextColor3 = Color3.fromRGB(255,200,50)
    aibs.Color = Color3.fromRGB(150,100,50)

    task.spawn(function()
        task.wait(0.3)
        local scanData = scanMap()
        AIStatusTxt.Text = "🧠 AI يحلل البيانات..."

        aiAnalyze(scanData, function(result)
            if result then
                -- تطبيق النتائج
                pcall(function()
                    ThrowRemote = resolvePath(result.throwRemote)
                end)
                pcall(function()
                    StrengthObj = resolvePath(result.strengthPath)
                end)
                pcall(function()
                    UpgradeRemote = resolvePath(result.upgradeRemote)
                end)
                pcall(function()
                    if result.throwArgs and type(result.throwArgs) == "table" then
                        ThrowArgs = result.throwArgs
                    end
                end)

                local throwFound = ThrowRemote ~= nil
                local strFound = StrengthObj ~= nil

                AIStatusTxt.Text = 
                    (throwFound and "✓ Throw: "..tostring(ThrowRemote.Name) or "✗ Throw: لم يُوجد")..
                    "\n"..
                    (strFound and "✓ Strength: "..tostring(StrengthObj.Value) or "✗ Strength: لم يُوجد")
                AIStatusTxt.TextColor3 = throwFound and
                    Color3.fromRGB(80,255,80) or Color3.fromRGB(255,150,50)
                aibs.Color = throwFound and
                    Color3.fromRGB(50,180,50) or Color3.fromRGB(150,100,50)
                aiDone = true
            else
                AIStatusTxt.Text = "✗ AI فشل — جرب إعادة التحليل"
                AIStatusTxt.TextColor3 = Color3.fromRGB(255,80,80)
                aibs.Color = Color3.fromRGB(160,30,30)

                -- Fallback يدوي
                pcall(function()
                    local Remotes = RS:FindFirstChild("Remotes")
                    if Remotes then
                        ThrowRemote = Remotes:FindFirstChild("Throw_Start")
                    end
                end)
                pcall(function()
                    for _, v in pairs(lp:GetDescendants()) do
                        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
                            if math.abs(v.Value - 7303) < 500 then
                                StrengthObj = v
                                break
                            end
                        end
                    end
                end)
                aiDone = true
            end
        end)
    end)
end

-- ========== SET STRENGTH ==========
local function applyStrength(val)
    -- مباشر
    pcall(function()
        if StrengthObj then
            StrengthObj.Value = val
        end
    end)
    -- عبر Upgrade Remote
    pcall(function()
        if UpgradeRemote then
            UpgradeRemote:FireServer(val)
        end
    end)
    -- بحث عام
    pcall(function()
        for _, v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                if n:find("strength") or n:find("upgrade") then
                    v:FireServer(val)
                end
            end
        end
    end)
end


-- ===== SPY على كل شيء =====
local old_nc
old_nc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if capturing then
        if method == "FireServer" or method == "InvokeServer"
        or method == "Fire" or method == "Invoke" then
            local args = {...}
            local entry = "["..method.."] "..self:GetFullName()
            for _, v in ipairs(args) do
                local t = typeof(v)
                if t=="number" then entry=entry.." | #"..string.format("%.4f",v)
                elseif t=="boolean" then entry=entry.." | bool:"..tostring(v)
                elseif t=="string" then entry=entry.." | str:"..v
                elseif t=="Vector3" then entry=entry.." | vec3:"..tostring(v)
                elseif t=="CFrame" then entry=entry.." | cf:"..tostring(v.Position)
                elseif t=="Instance" then entry=entry.." | inst:"..v:GetFullName()
                else entry=entry.." | "..t end
            end
            add(entry)
        end
    end
    return old_nc(self, ...)
end))

-- ===== مراقبة تغيير القيم =====
local watchedValues = {}
local function watchAllValues()
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local name = v.Name:lower()
            if name:find("luck") or name:find("meter") or name:find("bar")
            or name:find("power") or name:find("strength") or name:find("throw")
            or name:find("chance") or name:find("score") then
                local conn = v.Changed:Connect(function(newVal)
                    if capturing then
                        add("📊 VALUE_CHANGED: "..v:GetFullName().." = "..tostring(newVal))
                    end
                end)
                table.insert(watchedValues, conn)
            end
        end
    end
end
pcall(watchAllValues)


local function analyzeWithGroq(scanData, callback)
    local systemPrompt = [[You are an expert Roblox game reverse engineer.
Analyze the game data and respond in Arabic.
The game is "Throw Food for Animals" - player throws food, there is a vertical luck bar (0-20), strength value showing 7303.
Cover: 1) Game structure and zones 2) How throw system works 3) Which RemoteEvent handles throwing 4) Which value stores strength 5) How to hook luck bar to always be 20 6) Exact Lua code for both hacks.
Be precise, use only provided data.]]

    local ok, result = pcall(function()
        local resp = httpRequest({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. GROQ_KEY
            },
            Body = HS:JSONEncode({
                model = "openai/gpt-oss-120b",
                max_tokens = 2048,
                temperature = 0.3,
                messages = {
                    { role = "system", content = systemPrompt },
                    { role = "user", content = "بيانات الماب:\n" .. scanData }
                }
            })
        })

        if not resp then
            return "ERROR: HTTP function not found in this executor"
        end

        local decoded = HS:JSONDecode(resp.Body)
        if decoded.error then
            return "API ERROR: " .. tostring(decoded.error.message)
        end
        return decoded.choices[1].message.content
    end)

    callback(ok and result or ("ERROR: " .. tostring(result)))
end


local function httpReq(opt)
    if syn and syn.request then return syn.request(opt)
    elseif http_request then return http_request(opt)
    elseif request then return request(opt)
    else return nil end
end

local function scanMap()
    local lines = {}
    table.insert(lines,"REMOTES:")
    pcall(function()
        for _,v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(lines,v.ClassName.."|"..v:GetFullName())
            end
        end
    end)
    table.insert(lines,"VALUES:")
    pcall(function()
        for _,v in pairs(lp:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                table.insert(lines,v.Name.."="..tostring(v.Value).."|"..v:GetFullName())
            end
        end
    end)
    table.insert(lines,"GUI:")
    pcall(function()
        for _,v in pairs(lp.PlayerGui:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton")) and v.Text~="" and v.Visible then
                table.insert(lines,v.Name.."|"..v.Text)
            end
        end
    end)
    return table.concat(lines,"\n")
end

local function aiAnalyze(data,callback)
    local ok,result = pcall(function()
        local resp = httpReq({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer "..GROQ_KEY
            },
            Body = HS:JSONEncode({
                model = "openai/gpt-oss-120b",
                max_tokens = 500,
                messages = {
                    {role="system",content='Roblox exploit dev. Game: Throw Food for Animals. Luck bar 0-20, strength~7303. Reply ONLY valid JSON no markdown: {"throwRemote":"full.path","strengthPath":"full.path","throwArgs":[20]}'},
                    {role="user",content=data}
                }
            })
        })
        if not resp then return nil end
        local d = HS:JSONDecode(resp.Body)
        if d.error then return nil end
        local text = d.choices[1].message.content
        text = text:gsub("```json",""):gsub("```","")
        local s,e = text:find("{.+}")
        if s then text = text:sub(s,e) end
        return HS:JSONDecode(text)
    end)
    callback(ok and result or nil)
end

local function resolvePath(path)
    if not path or path=="" or path=="none" then return nil end
    local obj = game
    for part in path:gmatch("[^%.]+") do
        local found
        pcall(function()
            found = obj:FindFirstChild(part)
            if not found then found = obj[part] end
        end)
        if not found then return nil end
        obj = found
    end
    return obj
end


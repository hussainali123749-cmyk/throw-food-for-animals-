-- ===== NEARBY PARTS (أقرب 30 part للاعب) =====
header("NEAREST PARTS TO PLAYER")
pcall(function()
    local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if root then
        local playerPos = root.Position
        local parts = {}
        for _,v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                local dist = (v.Position - playerPos).Magnitude
                if dist < 100 then
                    table.insert(parts, {v=v, dist=dist})
                end
            end
        end
        table.sort(parts, function(a,b) return a.dist < b.dist end)
        for i=1,math.min(30,#parts) do
            local p = parts[i]
            add("dist:"..math.floor(p.dist).." | "..p.v.Name.." | "..tostring(p.v.Position).." | "..p.v:GetFullName())
        end
    end
end)


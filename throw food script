-- ========== HTTP ==========
local function httpReq(opt)
    if syn and syn.request then return syn.request(opt)
    elseif http_request then return http_request(opt)
    elseif request then return request(opt)
    else return nil end
end

-- ========== SCAN ==========
local function scanMap()
    local lines = {}
    table.insert(lines, "REMOTES:")
    pcall(function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(lines, v.ClassName.."|"..v:GetFullName())
            end
        end
    end)
    table.insert(lines, "PLAYER_VALUES:")
    pcall(function()
        for _, v in pairs(lp:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                table.insert(lines, v.Name.."="..tostring(v.Value).."|"..v:GetFullName())
            end
        end
    end)
    table.insert(lines, "LEADERSTATS:")
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            for _, v in pairs(ls:GetChildren()) do
                table.insert(lines, v.Name.."="..tostring(v.Value).."|"..v:GetFullName())
            end
        end
    end)
    table.insert(lines, "GUI_TEXTS:")
    pcall(function()
        for _, v in pairs(lp.PlayerGui:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton"))
            and v.Text ~= "" and v.Visible then
                table.insert(lines, v.Name.."|"..v.Text.."|"..v:GetFullName())
            end
        end
    end)
    return table.concat(lines, "\n")
end

-- ========== AI ANALYZE ==========
local function aiAnalyze(data, callback)
    local ok, result = pcall(function()
        local resp = httpReq({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer "..GROQ_KEY
            },
            Body = HS:JSONEncode({
                model = "openai/gpt-oss-120b",
                max_tokens = 800,
                messages = {
                    {
                        role = "system",
                        content = [[You are a Roblox exploit developer. 
Game: "Throw Food for Animals"
Mechanics: vertical luck bar 0-20, strength value ~7303, tap to throw.
From the scan data find EXACTLY:
1. Full path of RemoteEvent for throwing (like game.ReplicatedStorage.X.Y)
2. Full path of strength NumberValue/IntValue
3. What arguments does the throw RemoteEvent take (numbers? bool?)
4. Any RemoteEvent for upgrading strength

Reply ONLY as JSON, no markdown, no explanation:
{"throwRemote":"full.path.here","strengthPath":"full.path.here","throwArgs":[20],"upgradeRemote":"full.path.or.none"}]]
                    },
                    {role = "user", content = data}
                }
            })
        })
        if not resp then return nil end
        local d = HS:JSONDecode(resp.Body)
        if d.error then return nil end
        local text = d.choices[1].message.content
        -- نظف الـ JSON
        text = text:gsub("```json",""):gsub("```",""):match("{.+}")
        return HS:JSONDecode(text)
    end)
    callback(ok and result or nil)
end

-- ========== RESOLVE PATH ==========
local function resolvePath(path)
    if not path or path == "none" or path == "" then return nil end
    local obj = game
    for part in path:gmatch("[^%.]+") do
        local found = nil
        pcall(function()
            found = obj:FindFirstChild(part)
            if not found and obj[part] then
                found = obj[part]
            end
        end)
        if not found then return nil end
        obj = found
    end
    return obj
end


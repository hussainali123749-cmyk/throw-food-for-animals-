-- ===== SPY على InvokeServer =====
-- نراقب ما يُرسل فعلاً عند الرمية اليدوية
local spyLog = {}
local spyOn = false

local old_nc
old_nc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if spyOn and (method == "InvokeServer" or method == "FireServer") then
        local args = {...}
        local entry = {
            name = tostring(self.Name),
            method = method,
            args = {}
        }
        for _, v in ipairs(args) do
            local t = typeof(v)
            if t == "number" or t == "boolean" or t == "string" then
                table.insert(entry.args, t..":"..tostring(v))
            elseif t == "Vector3" then
                table.insert(entry.args, "Vec3:"..tostring(v))
            else
                table.insert(entry.args, t)
            end
        end
        table.insert(spyLog, entry)
    end
    return old_nc(self, ...)
end))


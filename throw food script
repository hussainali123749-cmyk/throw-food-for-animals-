local function getRoot()
    return lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
end

local function teleport(pos)
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(pos)
    end
end

local function getScreenCenter()
    local cam = workspace.CurrentCamera
    if cam then
        return cam.ViewportSize.X/2, cam.ViewportSize.Y/2
    end
    return 400, 300
end

local function simulateTap(x, y)
    pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    pcall(function()
        VIM:SendTouchEvent(0, Vector2.new(x, y), Enum.UserInputState.Begin)
        task.wait(0.05)
        VIM:SendTouchEvent(0, Vector2.new(x, y), Enum.UserInputState.End)
    end)
end


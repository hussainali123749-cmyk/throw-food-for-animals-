local drag,dInp,dSt,dPos = false,nil,nil,nil
TB.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseButton1 then
        drag=true; dSt=i.Position; dPos=Main.Position
        i.Changed:Connect(function()
            if i.UserInputState==Enum.UserInputState.End then drag=false end
        end)
    end
end)
TB.InputChanged:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.Touch
    or i.UserInputType==Enum.UserInputType.MouseButton1 then dInp=i end
end)
UIS.InputChanged:Connect(function(i)
    if i==dInp and drag then
        local d=i.Position-dSt
        Main.Position=UDim2.new(dPos.X.Scale,dPos.X.Offset+d.X,dPos.Y.Scale,dPos.Y.Offset+d.Y)
    end
end)

-- ===== AUTO THROW LOGIC =====
AutoBtn.MouseButton1Click:Connect(function()
    autoOn = not autoOn

    if autoOn then
        AutoBtn.Text = "  🤖  AUTO THROW — ON"
        AutoBtn.TextColor3 = Color3.fromRGB(80,255,80)
        autost.Color = Color3.fromRGB(50,200,50)

        task.spawn(function()
            while autoOn do

                                -- الخطوة 1: انتقل لمنطقة الرمي
                StTxt.Text = "📍 ينتقل..."
                StTxt.TextColor3 = Color3.fromRGB(255,200,50)

                -- تلبورت مرحلي: أولاً قريب ثم داخل المنطقة
                -- هذا يمنع مشكلة الخروج والدخول
                teleport(Vector3.new(0, 5.6, -40.0))
                task.wait(0.15)
                teleport(THROW_POS)
                task.wait(0.2)

                -- الخطوة 2: تأكد وصل
                local root = getRoot()
                if not root then task.wait(1) continue end
                local dist = (root.Position - THROW_POS).Magnitude
                if dist > 15 then
                    StTxt.Text = "⚠ لم يصل — يحاول مجدداً"
                    StTxt.TextColor3 = Color3.fromRGB(255,100,50)
                    task.wait(0.3)
                    continue
                end

                -- الخطوة 3: اضغط فوراً بدون تأخير
                StTxt.Text = "👆 يضغط..."
                StTxt.TextColor3 = Color3.fromRGB(100,200,255)
                local cx, cy = getScreenCenter()
                pcall(function() ThrowMeter:FireServer() end)
                simulateTap(cx, cy)

                -- الخطوة 4: انتظر يتحرك اللاعب = الرمية اكتملت
                StTxt.Text = "⏳ الخطوة 3: ينتظر اكتمال الرمية..."
                StTxt.TextColor3 = Color3.fromRGB(180,180,100)
                local completed = false
                for _=1,50 do
                    task.wait(0.1)
                    local r = getRoot()
                    if r and (r.Position - THROW_POS).Magnitude > 8 then
                        completed = true
                        break
                    end
                end

                -- الخطوة 5: زد العداد بعد اكتمال الرمية
                if completed then
                    throwCount = throwCount + 1
                    CountTxt.Text = "رميات: "..throwCount
                    StTxt.Text = "✅ الخطوة 4: رمية "..throwCount.." اكتملت"
                    StTxt.TextColor3 = Color3.fromRGB(80,255,80)
                else
                    StTxt.Text = "⚠ انتهت المهلة — سيحاول مجدداً"
                    StTxt.TextColor3 = Color3.fromRGB(255,150,50)
                end

                -- فاصل قبل الرمية التالية
                task.wait(throwDelay)
            end
        end)

    else
        autoOn = false
        AutoBtn.Text = "  🤖  AUTO THROW — OFF"
        AutoBtn.TextColor3 = Color3.fromRGB(160,160,160)
        autost.Color = Color3.fromRGB(80,50,160)
        StTxt.Text = "● Stopped"
        StTxt.TextColor3 = Color3.fromRGB(220,80,80)
    end
end)

-- ===== AUTO TRAIN LOGIC =====
TrainBtn.MouseButton1Click:Connect(function()
    trainOn = not trainOn

    if trainOn then
        TrainBtn.Text = "  💪  AUTO TRAIN — ON"
        TrainBtn.TextColor3 = Color3.fromRGB(80,255,80)
        trainst.Color = Color3.fromRGB(50,200,50)

        task.spawn(function()
            while trainOn do
                -- انتقل
                StTxt.Text = "📍 ينتقل للتدريب..."
                StTxt.TextColor3 = Color3.fromRGB(255,200,50)
                teleport(TRAIN_POS)
                task.wait(0.5)

                -- ابدأ التدريب
                StTxt.Text = "💪 يتدرب..."
                StTxt.TextColor3 = Color3.fromRGB(100,255,100)
                pcall(function() Training_Start:InvokeServer() end)
                task.wait(0.1)

                local cx, cy = getScreenCenter()
                for i=1,30 do
                    if not trainOn then break end
                    pcall(function() Training_Bonus:InvokeServer() end)
                    simulateTap(cx, cy)
                    task.wait(0.03)
                end

                task.wait(0.1)
                pcall(function() Training_Stop:InvokeServer() end)

                -- زد عداد التدريب
                trainCount = trainCount + 1
                TrainCountTxt.Text = "تدريبات: "..trainCount

                -- اعرض القوة الحالية
                local ls = lp:FindFirstChild("leaderstats")
                local tp = ls and ls:FindFirstChild("Throw Power")
                if tp then
                    StTxt.Text = "💪 Power: "..tostring(tp.Value)
                    StTxt.TextColor3 = Color3.fromRGB(80,255,80)
                end

                task.wait(0.3)
            end
        end)

    else
        trainOn = false
        TrainBtn.Text = "  💪  AUTO TRAIN — OFF"
        TrainBtn.TextColor3 = Color3.fromRGB(160,160,160)
        trainst.Color = Color3.fromRGB(80,50,160)
        StTxt.Text = "● Train Stopped"
        StTxt.TextColor3 = Color3.fromRGB(220,80,80)
    end
end)


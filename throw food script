-- ===== FUNCTIONS =====
local function doThrow()
    local ok1, r1 = pcall(function()
        return Throw_Start:InvokeServer()
    end)
    task.wait(0.05)
    local ok2, r2 = pcall(function()
        return Throw_Complete:InvokeServer()
    end)
    return ok1 or ok2
end

local function doTrain()
    pcall(function() Training_Start:InvokeServer() end)
    task.wait(0.1)
    for i = 1, 30 do
        pcall(function() Training_TapBonus:InvokeServer() end)
        task.wait(0.02)
    end
    task.wait(0.1)
    pcall(function() Training_Stop:InvokeServer() end)
end

local function setPower(val)
    local ok, result = pcall(function()
        return Player_SetThrowPower:InvokeServer(val)
    end)
    return ok
end


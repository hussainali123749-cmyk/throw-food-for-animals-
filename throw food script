local function analyzeWithGroq(scanData, callback)
    local systemPrompt = [[
You are an expert Roblox game reverse engineer and exploit developer.
You analyze raw game data dumps and reconstruct the full game architecture like a human player who has mastered the game.

Your analysis must be in Arabic and cover:
1. GAME STRUCTURE: What areas/zones exist, what is each area for
2. MECHANICS: How the throw system works, what triggers it, what values control luck and strength
3. REMOTE EVENTS: Which RemoteEvent handles throwing, which handles strength/upgrades
4. GUI SYSTEM: Which GUI element is the luck bar, how it moves, what its max value is
5. VALUES: Which NumberValue/IntValue stores strength (the one showing 7303)
6. EXPLOIT TARGETS: Exact paths and names for hooking the throw, the luck bar, and the strength value
7. RECOMMENDED HOOKS: Write the exact Lua hook code for:
   a) Auto-maxing the luck bar to 20
   b) Setting strength to any value

Be extremely precise. Use only the data provided. Think like a human who played this game for 100 hours.
]]

    local userPrompt = "هذه بيانات الماب الكاملة. حللها كإنسان خبير:\n\n" .. scanData

    local ok, result = pcall(function()
        local resp = (syn and syn.request or request)({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer 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"
            },
            Body = HS:JSONEncode({
                model = "deepseek-r1-distill-llama-70b",
                max_tokens = 4096,
                temperature = 0.3,
                messages = {
                    { role = "system", content = systemPrompt },
                    { role = "user",   content = userPrompt }
                }
            })
        })
        local decoded = HS:JSONDecode(resp.Body)
        return decoded.choices[1].message.content
    end)

    callback(ok and result or ("ERROR: " .. tostring(result)))
end


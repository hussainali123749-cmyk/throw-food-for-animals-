-- AI SCAN
local function runScan()
    aiDone=false
    AITxt.Text="🧠 جاري المسح..."
    AITxt.TextColor3=Color3.fromRGB(255,200,50)
    aibs.Color=Color3.fromRGB(150,100,50)

    task.spawn(function()
        task.wait(0.3)
        local data=scanMap()
        AITxt.Text="🧠 AI يحلل..."

        aiAnalyze(data,function(r)
            if r then
                pcall(function() ThrowRemote=resolvePath(r.throwRemote) end)
                pcall(function() StrengthObj=resolvePath(r.strengthPath) end)
                pcall(function()
                    if r.throwArgs and type(r.throwArgs)=="table" then
                        ThrowArgs=r.throwArgs
                    end
                end)
                local tok = ThrowRemote~=nil
                local sok = StrengthObj~=nil
                AITxt.Text=
                    (tok and "✓ Throw: "..ThrowRemote.Name or "✗ Throw: لم يُوجد")..
                    "\n"..
                    (sok and "✓ Str: "..tostring(StrengthObj.Value) or "✗ Str: لم يُوجد")
                AITxt.TextColor3=tok and Color3.fromRGB(80,255,80) or Color3.fromRGB(255,150,50)
                aibs.Color=tok and Color3.fromRGB(50,180,50) or Color3.fromRGB(150,100,50)
            else
                -- Fallback
                pcall(function()
                    ThrowRemote=RS:FindFirstChild("Remotes"):FindFirstChild("Throw_Start")
                end)
                pcall(function()
                    for _,v in pairs(lp:GetDescendants()) do
                        if (v:IsA("NumberValue") or v:IsA("IntValue")) and math.abs(v.Value-7303)<500 then
                            StrengthObj=v break
                        end
                    end
                end)
                AITxt.Text="⚠ AI فشل — استخدم Fallback\n"..(ThrowRemote and "✓ "..ThrowRemote.Name or "✗ Throw لم يُوجد")
                AITxt.TextColor3=Color3.fromRGB(255,180,50)
                aibs.Color=Color3.fromRGB(150,100,30)
            end
            aiDone=true
        end)
    end)
end

-- APPLY STRENGTH
local function applyStr(val)
    pcall(function() if StrengthObj then StrengthObj.Value=val end end)
    pcall(function()
        for _,v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n=v.Name:lower()
                if n:find("strength") or n:find("upgrade") then v:FireServer(val) end
            end
        end
    end)
end


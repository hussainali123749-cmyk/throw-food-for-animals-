-- ========== DEEP SCAN ==========
local function deepScan()
    local data = {}

    -- معلومات اللاعب
    local playerInfo = {
        name = lp.Name,
        displayName = lp.DisplayName,
        userId = lp.UserId,
    }
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            playerInfo.leaderstats = {}
            for _, v in pairs(ls:GetChildren()) do
                playerInfo.leaderstats[v.Name] = tostring(v.Value)
            end
        end
    end)
    data.player = playerInfo

    -- كل القيم داخل اللاعب
    data.playerValues = {}
    pcall(function()
        for _, v in pairs(lp:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue")
            or v:IsA("StringValue") or v:IsA("BoolValue")
            or v:IsA("Vector3Value") then
                table.insert(data.playerValues, {
                    name = v.Name,
                    type = v.ClassName,
                    value = tostring(v.Value),
                    path = v:GetFullName()
                })
            end
        end
    end)

    -- RemoteEvents و Functions
    data.remotes = {}
    pcall(function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction")
            or v:IsA("BindableEvent") or v:IsA("BindableFunction") then
                table.insert(data.remotes, {
                    type = v.ClassName,
                    name = v.Name,
                    path = v:GetFullName()
                })
            end
        end
    end)

    -- GUI كامل مع النصوص والأحجام
    data.gui = {}
    pcall(function()
        for _, v in pairs(lp.PlayerGui:GetDescendants()) do
            local entry = {
                type = v.ClassName,
                name = v.Name,
                path = v:GetFullName(),
            }
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                entry.text = v.Text
                entry.textSize = v.TextSize
                entry.textColor = tostring(v.TextColor3)
            end
            if v:IsA("GuiObject") then
                entry.visible = v.Visible
                entry.absSize = tostring(v.AbsoluteSize)
                entry.absPos = tostring(v.AbsolutePosition)
                entry.bgColor = tostring(v.BackgroundColor3)
                entry.transparency = v.BackgroundTransparency
            end
            if v:IsA("Frame") then
                entry.childCount = #v:GetChildren()
            end
            table.insert(data.gui, entry)
        end
    end)

    -- Workspace: كل شيء مهم
    data.workspace = {}
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui")
            or v:IsA("Part") or v:IsA("MeshPart")
            or v:IsA("Model") or v:IsA("Folder")
            or v:IsA("Script") or v:IsA("LocalScript")
            or v:IsA("NumberValue") or v:IsA("IntValue")
            or v:IsA("StringValue") then
                local entry = {
                    type = v.ClassName,
                    name = v.Name,
                    path = v:GetFullName(),
                }
                if v:IsA("BasePart") then
                    entry.position = tostring(v.Position)
                    entry.size = tostring(v.Size)
                    entry.color = tostring(v.Color)
                end
                if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                    entry.enabled = v.Enabled
                    entry.children = {}
                    for _, c in pairs(v:GetDescendants()) do
                        local cEntry = {
                            type = c.ClassName,
                            name = c.Name
                        }
                        if c:IsA("TextLabel") then
                            cEntry.text = c.Text
                        end
                        if c:IsA("Frame") and c:IsA("GuiObject") then
                            cEntry.size = tostring(c.AbsoluteSize)
                            cEntry.bgColor = tostring(c.BackgroundColor3)
                        end
                        table.insert(entry.children, cEntry)
                    end
                end
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    entry.value = tostring(v.Value)
                end
                table.insert(data.workspace, entry)
            end
        end
    end)

    -- ReplicatedStorage كامل
    data.replicatedStorage = {}
    pcall(function()
        for _, v in pairs(RS:GetDescendants()) do
            table.insert(data.replicatedStorage, {
                type = v.ClassName,
                name = v.Name,
                path = v:GetFullName()
            })
        end
    end)

    -- موقع اللاعب الحالي
    data.playerPosition = "unknown"
    pcall(function()
        local char = lp.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                data.playerPosition = tostring(root.Position)
            end
        end
    end)

    -- الـ Camera
    data.cameraPos = tostring(workspace.CurrentCamera.CFrame.Position)

    return HS:JSONEncode(data)
end


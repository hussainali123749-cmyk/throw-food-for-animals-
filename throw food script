-- ========== PROTECTION LAYER ==========
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if method == "FireServer" then
        -- نراقب كل RemoteEvent يُرسل
        local remote = tostring(self.Name)
        -- نعدل قيمة الـ Luck قبل الإرسال
        if remote:lower():find("throw") or remote:lower():find("luck") 
        or remote:lower():find("food") or remote:lower():find("power") then
            for i, v in pairs(args) do
                if type(v) == "number" and v <= 20 then
                    args[i] = 20
                end
            end
        end
        return old(self, table.unpack(args))
    end
    return old(self, ...)
end)
setreadonly(mt, true)

-- ========== STRENGTH MODIFIER ==========
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local function setStrength(val)
    -- بحث في كل الأماكن الممكنة
    local targets = {
        lp.leaderstats,
        lp.Character,
        lp:FindFirstChild("PlayerData"),
        lp:FindFirstChild("Stats"),
        lp:FindFirstChild("Data"),
    }
    for _, target in pairs(targets) do
        if target then
            for _, v in pairs(target:GetDescendants()) do
                if v:IsA("NumberValue") or v:IsA("IntValue") then
                    local n = v.Name:lower()
                    if n:find("strength") or n:find("power") 
                    or n:find("قوة") or n:find("str") then
                        v.Value = val
                    end
                end
            end
        end
    end
    -- RemoteEvent للقوة
    local Remote = game:GetService("ReplicatedStorage")
    for _, v in pairs(Remote:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("strength") or n:find("power") or n:find("upgrade") then
                v:FireServer(val)
            end
        end
    end
end


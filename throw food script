local function scanMap()
    local lines = {}

    table.insert(lines,"=REMOTES=")
    pcall(function()
        for _,v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(lines,v.ClassName.."|"..v:GetFullName())
            end
        end
    end)

    table.insert(lines,"=PLAYER_VALUES=")
    pcall(function()
        for _,v in pairs(lp:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue")
            or v:IsA("StringValue") or v:IsA("BoolValue") then
                table.insert(lines,v.Name.."="..tostring(v.Value).."|"..v:GetFullName())
            end
        end
    end)

    table.insert(lines,"=LEADERSTATS=")
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            for _,v in pairs(ls:GetChildren()) do
                table.insert(lines,v.Name.."="..tostring(v.Value).."|"..v:GetFullName())
            end
        end
    end)

    table.insert(lines,"=GUI_TEXTS=")
    pcall(function()
        for _,v in pairs(lp.PlayerGui:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton"))
            and v.Text ~= "" and v.Visible then
                table.insert(lines,v.Name.."|"..v.Text.."|"..v:GetFullName())
            end
        end
    end)

    table.insert(lines,"=WORKSPACE_PARTS=")
    pcall(function()
        local count = 0
        for _,v in pairs(workspace:GetDescendants()) do
            if count > 60 then break end
            if v:IsA("Model") or v:IsA("Folder") then
                table.insert(lines,"Model|"..v.Name.."|"..v:GetFullName())
                count = count + 1
            end
        end
    end)

    table.insert(lines,"=REPLICATED_STORAGE=")
    pcall(function()
        for _,v in pairs(RS:GetDescendants()) do
            table.insert(lines,v.ClassName.."|"..v.Name.."|"..v:GetFullName())
        end
    end)

    -- موقع اللاعب
    pcall(function()
        local root = lp.Character
            and lp.Character:FindFirstChild("HumanoidRootPart")
        if root then
            table.insert(lines,"=PLAYER_POS=")
            table.insert(lines,tostring(root.Position))
        end
    end)

    return table.concat(lines,"\n")
end

-- ========== AI ==========
local function aiAnalyze(data, callback)
    local systemPrompt = [[
You are an elite Roblox game reverse engineer with 10 years experience.
You are analyzing "Throw Food for Animals" game.

WHAT YOU KNOW ABOUT THIS GAME:
- Player stands in a zone, a vertical bar appears (0 to 20)
- Bar moves up and down automatically
- Player taps screen to throw food at the right moment
- If bar stops at 20 = maximum luck = better animals = more money
- Player has a Strength stat (currently around 7303) that determines throw distance
- There is a gym/weights area where player trains to increase strength
- RemoteEvent "Throw_Start" exists in ReplicatedStorage.Remotes

YOUR MISSION - analyze the scan data and answer EXACTLY:
1. What arguments does Throw_Start FireServer send?
2. Is luck value sent FROM client TO server, or calculated on server?
3. What is the EXACT path of the Strength value showing ~7303?
4. Is there a RemoteEvent for strength upgrade? What args does it take?
5. What other RemoteEvents relate to throwing or luck?
6. How does the bar system work based on GUI elements?

Reply ONLY as valid JSON, no markdown, no explanation:
{"throwRemote":"exact.full.path","throwArgs":[20],"luckSentFromClient":true,"strengthPath":"exact.full.path","strengthValue":7303,"upgradeRemote":"path or none","upgradeArgs":[],"barGuiPath":"path or none","analysis":"explanation here"}
]]

    local ok, result = pcall(function()
        local resp = httpReq({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer "..GROQ_KEY
            },
            Body = HS:JSONEncode({
                model = "openai/gpt-oss-120b",
                max_tokens = 600,
                temperature = 0.1,
                messages = {
                    {role="system", content=systemPrompt},
                    {role="user",   content="SCAN DATA:\n"..data}
                }
            })
        })
        if not resp then return nil end
        local d = HS:JSONDecode(resp.Body)
        if d.error then return nil end
        local text = d.choices[1].message.content
        text = text:gsub("```json",""):gsub("```",""):gsub("^%s+",""):gsub("%s+$","")
        local s,e = text:find("{.+}")
        if s then text = text:sub(s,e) end
        return HS:JSONDecode(text)
    end)
    callback(ok and result or nil)
end

-- ========== RESOLVE PATH ==========
local function resolvePath(path)
    if not path or path=="" or path=="none" then return nil end
    local obj = game
    for part in path:gmatch("[^%.]+") do
        local found
        pcall(function()
            found = obj:FindFirstChild(part)
            if not found then found = obj[part] end
        end)
        if not found then return nil end
        obj = found
    end
    return obj
end


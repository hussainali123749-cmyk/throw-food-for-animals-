local function watchGUI()
    for _, v in pairs(lp.PlayerGui:GetDescendants()) do
        if v:IsA("Frame") then
            local conn = v:GetPropertyChangedSignal("Size"):Connect(function()
                if capturing then
                    add("🎨 FRAME_SIZE: "..v:GetFullName()
                        .." size:"..tostring(v.Size)
                        .." absSize:"..tostring(v.AbsoluteSize))
                end
            end)
            table.insert(watchedValues, conn)
        end
        if v:IsA("TextLabel") then
            local conn = v:GetPropertyChangedSignal("Text"):Connect(function()
                if capturing then
                    add("📝 TEXT_CHANGED: "..v:GetFullName().." = \""..v.Text.."\"")
                end
            end)
            table.insert(watchedValues, conn)
        end
    end
end
pcall(watchGUI)

-- ===== مراقبة Character =====
local function watchCharacter()
    local char = lp.Character
    if not char then return end
    -- مراقبة Humanoid
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if capturing then
                add("🚶 WALKSPEED: "..tostring(hum.WalkSpeed))
            end
        end)
        hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if capturing then
                add("⬆️ JUMPPOWER: "..tostring(hum.JumpPower))
            end
        end)
    end
    -- مراقبة موقع HumanoidRootPart
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local lastPos = root.Position
        game:GetService("RunService").Heartbeat:Connect(function()
            if capturing then
                local dist = (root.Position - lastPos).Magnitude
                if dist > 1 then
                    add("📍 MOVED: "..tostring(root.Position))
                    lastPos = root.Position
                end
            end
        end)
    end
end
pcall(watchCharacter)


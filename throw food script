local function httpReq(opt)
    if syn and syn.request then return syn.request(opt)
    elseif http_request then return http_request(opt)
    elseif request then return request(opt)
    else return nil end
end

local function deepScan()
    local lines = {}

    table.insert(lines, "REMOTES:")
    pcall(function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(lines, v.ClassName.."|"..v:GetFullName())
            end
        end
    end)

    table.insert(lines, "VALUES:")
    pcall(function()
        for _, v in pairs(lp:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                table.insert(lines, v.Name.."="..tostring(v.Value))
            end
        end
    end)

    table.insert(lines, "STATS:")
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            for _, v in pairs(ls:GetChildren()) do
                table.insert(lines, v.Name.."="..tostring(v.Value))
            end
        end
    end)

    table.insert(lines, "GUI:")
    pcall(function()
        for _, v in pairs(lp.PlayerGui:GetDescendants()) do
            if (v:IsA("TextLabel") or v:IsA("TextButton"))
            and v.Text ~= "" and v.Visible then
                table.insert(lines, v.Name.."|"..v.Text)
            end
        end
    end)

    table.insert(lines, "BILLBOARDS:")
    local bb = 0
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if (v:IsA("BillboardGui") or v:IsA("SurfaceGui")) and bb < 20 then
                bb = bb + 1
                table.insert(lines, v.Name.."|"..v:GetFullName())
            end
        end
    end)

    return table.concat(lines, "\n")
end

local function analyze(scanData, callback)
    local ok, result = pcall(function()
        local resp = httpReq({
            Url = "https://api.groq.com/openai/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. GROQ_KEY
            },
            Body = HS:JSONEncode({
                model = "openai/gpt-oss-120b",
                max_tokens = 1500,
                messages = {
                    {
                        role = "system",
                        content = "Roblox reverse engineer. Game: Throw Food for Animals. Luck bar 0-20, strength=7303. Find: 1)RemoteEvent for throw 2)Strength value path 3)Hook code for both. Reply in Arabic. Be concise."
                    },
                    {
                        role = "user",
                        content = scanData
                    }
                }
            })
        })
        if not resp then return "ERROR: HTTP nil" end
        local d = HS:JSONDecode(resp.Body)
        if d.error then return "API ERROR: " .. tostring(d.error.message) end
        return d.choices[1].message.content
    end)
    callback(ok and result or ("ERROR: " .. tostring(result)))
end


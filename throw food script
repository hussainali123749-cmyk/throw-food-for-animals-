-- ========== HTTP FUNCTION ==========
local function httpRequest(options)
    -- Delta و executors مختلفة
    if syn and syn.request then
        return syn.request(options)
    elseif http and http.request then
        return http.request(options)
    elseif http_request then
        return http_request(options)
    elseif request then
        return request(options)
    elseif fetchAsync then
        return fetchAsync(options)
    else
        return nil
    end
end

-- ========== DEEP SCAN ==========
local function deepScan()
    local data = {}

    -- Remotes فقط - الأهم
    data.remotes = {}
    pcall(function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                table.insert(data.remotes, v.ClassName.."|||"..v:GetFullName())
            end
        end
    end)

    -- قيم اللاعب فقط
    data.values = {}
    pcall(function()
        for _, v in pairs(lp:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                table.insert(data.values, v.Name.."="..tostring(v.Value).."|||"..v:GetFullName())
            end
        end
    end)

    -- Leaderstats
    data.stats = {}
    pcall(function()
        local ls = lp:FindFirstChild("leaderstats")
        if ls then
            for _, v in pairs(ls:GetChildren()) do
                table.insert(data.stats, v.Name.."="..tostring(v.Value))
            end
        end
    end)

    -- GUI النصوص فقط
    data.gui = {}
    pcall(function()
        for _, v in pairs(lp.PlayerGui:GetDescendants()) do
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                if v.Text ~= "" then
                    table.insert(data.gui, v.ClassName.."|||"..v.Name.."|||"..v.Text.."|||"..v:GetFullName())
                end
            end
        end
    end)

    -- BillboardGui في workspace
    data.billboards = {}
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                local entry = v.ClassName.."|||"..v.Name.."|||"..v:GetFullName()
                for _, c in pairs(v:GetDescendants()) do
                    if c:IsA("TextLabel") then
                        entry = entry .. ">>>" .. c.Name .. "=" .. c.Text
                    end
                end
                table.insert(data.billboards, entry)
            end
        end
    end)

    -- موقع اللاعب
    pcall(function()
        local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if root then data.pos = tostring(root.Position) end
    end)

    return HS:JSONEncode(data)
end


header("REPLICATED STORAGE TREE")
pcall(function()
    local function scan(obj, depth)
        if depth > 6 then return end
        for _,v in pairs(obj:GetChildren()) do
            local extra = ""
            if v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue") then
                extra = " = "..tostring(v.Value)
            end
            add(string.rep("  ",depth)..v.ClassName.." | "..v.Name..extra)
            scan(v, depth+1)
        end
    end
    scan(RS, 0)
end)

header("WORKSPACE STRUCTURE")
pcall(function()
    local function scan(obj, depth)
        if depth > 5 then return end
        for _,v in pairs(obj:GetChildren()) do
            local extra = ""
            if v:IsA("BasePart") then
                extra = " | pos:"..tostring(v.Position).." | size:"..tostring(v.Size)
            elseif v:IsA("NumberValue") or v:IsA("IntValue") then
                extra = " | val:"..tostring(v.Value)
            end
            add(string.rep("  ",depth)..v.ClassName.." | "..v.Name..extra)
            scan(v, depth+1)
        end
    end
    scan(workspace, 0)
end)

header("IMPORTANT PARTS BY KEYWORD")
local keywords = {
    "throw","start","zone","gym","weight","strength","power",
    "animal","feed","food","luck","meter","spawn","train",
    "lift","press","begin","area","region","plot","station",
    "launch","toss","fling","bar","gauge","indicator","trigger"
}
pcall(function()
    for _,v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            local name = v.Name:lower()
            for _,kw in ipairs(keywords) do
                if name:find(kw) then
                    local pos = "?"
                    pcall(function()
                        if v:IsA("BasePart") then
                            pos = tostring(v.Position)
                        else
                            local p = v:FindFirstChildWhichIsA("BasePart",true)
                            if p then pos = tostring(p.Position) end
                        end
                    end)
                    add(v.ClassName.." | "..v.Name.." | "..pos.." | "..v:GetFullName())
                    break
                end
            end
        end
    end
end)

header("GUI FULL")
pcall(function()
    local function scan(obj, depth)
        if depth > 5 then return end
        for _,v in pairs(obj:GetChildren()) do
            local extra = ""
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                extra = " | text:\""..tostring(v.Text).."\""
            end
            if v:IsA("GuiObject") then
                extra = extra.." | vis:"..tostring(v.Visible)
                extra = extra.." | sz:"..tostring(v.AbsoluteSize)
            end
            add(string.rep("  ",depth)..v.ClassName.." | "..v.Name..extra)
            scan(v, depth+1)
        end
    end
    scan(lp.PlayerGui, 0)
end)

header("WORKSPACE VALUES")

-- شغّله وأنت واقف في منطقة الرمية
-- ثم اذهب للتدريب وشغّله مرة ثانية
local lp = game.Players.LocalPlayer
local root = lp.Character:FindFirstChild("HumanoidRootPart")
local TS = game:GetService("TweenService")

local sg = Instance.new("ScreenGui")
sg.Parent = lp.PlayerGui
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0,280,0,120)
frame.Position = UDim2.new(0,10,0,10)
frame.BackgroundColor3 = Color3.fromRGB(8,8,18)
frame.Parent = sg
Instance.new("UICorner",frame).CornerRadius = UDim.new(0,10)

local txt = Instance.new("TextLabel")
txt.Size = UDim2.new(1,-10,0.6,0)
txt.Position = UDim2.new(0,5,0,5)
txt.BackgroundTransparency = 1
txt.TextColor3 = Color3.fromRGB(80,255,80)
txt.TextSize = 10
txt.Font = Enum.Font.GothamBold
txt.TextXAlignment = Enum.TextXAlignment.Left
txt.TextWrapped = true
txt.Parent = frame

local copyBtn = Instance.new("TextButton")
copyBtn.Size = UDim2.new(1,-10,0,30)
copyBtn.Position = UDim2.new(0,5,0.65,0)
copyBtn.BackgroundColor3 = Color3.fromRGB(20,100,20)
copyBtn.TextColor3 = Color3.new(1,1,1)
copyBtn.TextSize = 11
copyBtn.Font = Enum.Font.GothamBold
copyBtn.Text = "📋 COPY"
copyBtn.BorderSizePixel = 0
copyBtn.Parent = frame
Instance.new("UICorner",copyBtn).CornerRadius = UDim.new(0,6)

local lastText = ""

game:GetService("RunService").Heartbeat:Connect(function()
    if root then
        local p = root.Position
        lastText = string.format("X: %.1f\nY: %.1f\nZ: %.1f\nPath: %s",
            p.X, p.Y, p.Z, root:GetFullName())
        txt.Text = lastText
    end
end)

copyBtn.MouseButton1Click:Connect(function()
    pcall(function() setclipboard(lastText) end)
    copyBtn.Text = "✓ تم"
    task.wait(1)
    copyBtn.Text = "📋 COPY"
end)

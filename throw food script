-- بحث عن البار العمودي في GUI
local function findLuckBar()
    for _, v in pairs(lp.PlayerGui:GetDescendants()) do
        if v:IsA("Frame") then
            -- البار العمودي عادة Size.Y أكبر من Size.X
            if v.AbsoluteSize.Y > v.AbsoluteSize.X * 1.5 then
                return v
            end
        end
    end
    return nil
end

-- بحث عن قيمة القوة
local function findStrengthValue()
    -- في leaderstats أولاً
    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        for _, v in pairs(ls:GetChildren()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = v.Name:lower()
                if n:find("strength") or n:find("str") 
                or n:find("power") or n:find("muscle") then
                    return v
                end
            end
        end
    end
    -- بحث أعمق
    for _, v in pairs(lp:GetDescendants()) do
        if (v:IsA("NumberValue") or v:IsA("IntValue")) then
            if math.abs(v.Value - 7303) < 100 then
                return v
            end
        end
    end
    return nil
end

-- ========== INTERCEPT THROW ==========
-- نعترض الضغط ونحقن قيمة 20
local luckHackActive = false
local strengthValue = 100

-- Hook على FireServer
local mt = getrawmetatable(game)
local old_namecall
old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "FireServer" and luckHackActive then
        local args = {...}
        -- نبدل أي رقم صغير بـ 20 (قيمة البار)
        for i, v in ipairs(args) do
            if type(v) == "number" then
                if v >= 0 and v <= 25 then
                    args[i] = 20
                end
            end
        end
        return old_namecall(self, table.unpack(args))
    end
    -- Strength hack
    if method == "FireServer" then
        local args = {...}
        local sname = tostring(self.Name):lower()
        if sname:find("strength") or sname:find("upgrade") 
        or sname:find("train") or sname:find("muscle") then
            for i, v in ipairs(args) do
                if type(v) == "number" then
                    args[i] = strengthValue
                end
            end
            return old_namecall(self, table.unpack(args))
        end
    end
    return old_namecall(self, ...)
end))


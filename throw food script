AppBtn.MouseButton1Click:Connect(function()
    StTxt.Text = "● جاري..."
    StTxt.TextColor3 = Color3.fromRGB(255,200,50)
    pcall(function()
        if StrengthObj then StrengthObj.Value = customStr end
    end)
    pcall(function()
        for _,v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local n = v.Name:lower()
                if n:find("strength") or n:find("upgrade") or n:find("train") then
                    v:FireServer(customStr)
                end
            end
        end
    end)
    task.wait(0.3)
    local cur = StrengthObj and tostring(StrengthObj.Value) or tostring(customStr)
    StTxt.Text = "● Strength = "..cur
    StTxt.TextColor3 = Color3.fromRGB(80,255,80)
end)


-- ===== REPLICATED STORAGE FULL =====
header("REPLICATED STORAGE FULL TREE")
pcall(function()
    local function scanRS(obj, depth)
        if depth > 6 then return end
        for _,v in pairs(obj:GetChildren()) do
            add(string.rep("  ",depth)..v.ClassName.." | "..v.Name)
            if v:IsA("NumberValue") or v:IsA("IntValue") or v:IsA("StringValue") then
                add(string.rep("  ",depth).."  VALUE: "..tostring(v.Value))
            end
            scanRS(v, depth+1)
        end
    end
    scanRS(RS, 0)
end)

-- ===== WORKSPACE FULL STRUCTURE =====
header("WORKSPACE FULL STRUCTURE")
pcall(function()
    local function scanWS(obj, depth)
        if depth > 5 then return end
        for _,v in pairs(obj:GetChildren()) do
            local extra = ""
            if v:IsA("BasePart") then
                extra = " | pos:"..tostring(v.Position).." | size:"..tostring(v.Size)
            elseif v:IsA("NumberValue") or v:IsA("IntValue") then
                extra = " | val:"..tostring(v.Value)
            end
            add(string.rep("  ",depth)..v.ClassName.." | "..v.Name..extra)
            scanWS(v, depth+1)
        end
    end
    scanWS(workspace, 0)
end)

-- ===== IMPORTANT PARTS (keywords) =====
header("IMPORTANT PARTS BY KEYWORD")
local keywords = {
    "throw","start","zone","gym","weight","strength","power",
    "animal","feed","food","luck","meter","spawn","train",
    "lift","press","begin","area","region","plot","station",
    "launch","toss","fling","bar","gauge","indicator"
}
pcall(function()
    for _,v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") or v:IsA("Part") then
            local name = v.Name:lower()
            for _,kw in ipairs(keywords) do
                if name:find(kw) then
                    local pos = "?"
                    pcall(function()
                        if v:IsA("BasePart") then
                            pos = tostring(v.Position)
                        else
                            local p = v:FindFirstChildWhichIsA("BasePart",true)
                            if p then pos = tostring(p.Position) end
                        end
                    end)
                    add(v.ClassName.." | "..v.Name.." | "..pos.." | "..v:GetFullName())
                    break
                end
            end
        end
    end
end)

